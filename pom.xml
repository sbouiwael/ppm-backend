<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot 3.5.10 — derniere patch de la ligne 3.5.x (target mai 2026).
        Patche notamment "Spring Boot predictable temporary directory" present
        dans spring-boot-3.5.5.jar et tire les dernieres versions du BOM
        (Spring Framework, Spring Security, Tomcat, Jackson).
        Verification : mvn versions:display-parent-updates
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/>
    </parent>

    <groupId>org.pfe</groupId>
    <artifactId>PPM_project</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>PPM_project</name>

    <properties>
        <java.version>17</java.version>
        <lombok.version>1.18.42</lombok.version>
        <springdoc.version>2.7.0</springdoc.version>

        <!--
            ============================================================
            Overrides de securite — versions patchees pinned manuellement
            ============================================================
            Toutes ces properties sont DEJA reconnues par le BOM Spring Boot.
            On les force au cas ou Spring Boot 3.5.10 n'aurait pas encore
            integre les patches les plus recents. Ces overrides restent dans
            les memes minor lines -> pas de risque d'incompat API.

            Si le build Maven echoue "Could not find artifact X:vY", c'est que
            la version pinnee n'existe pas encore sur Maven Central -> baisser
            d'un patch (ex: 6.2.13 -> 6.2.12). Verifier avec :
            mvn versions:display-property-updates
        -->
        <!-- Tomcat — patche info disclosure (log files + JsonAccessLogValve) + client cert bypass -->
        <tomcat.version>10.1.55</tomcat.version>

        <!-- Spring Security — patche race condition OneTimeToken + timing attack defense bypass -->
        <spring-security.version>6.5.10</spring-security.version>

        <!-- Spring Framework — patche Annotation Detection + scripting + cache poisoning + SSE -->
        <spring-framework.version>6.2.18</spring-framework.version>

        <!-- Jackson — patche Number Length Constraint Bypass DoS (2.21.x managed by Spring Boot 3.5.14) -->
        <jackson-bom.version>2.21.2</jackson-bom.version>

        <!-- Apache Commons Lang — patche CVE-2025-48924 (Uncontrolled Recursion) -->
        <commons-lang3.version>3.18.0</commons-lang3.version>

        <!-- Logback — patche conditional code exec + malicious config -->
        <logback.version>1.5.32</logback.version>
    </properties>

    <dependencies>
        <!-- REST API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MySQL driver -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Swagger / OpenAPI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Actuator (health probes, metrics) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Micrometer Prometheus registry (for Grafana/Prometheus scraping) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Flyway (database migrations — replaces ddl-auto=update in production) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- H2 in-memory database for integration tests (contextLoads) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>17</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
