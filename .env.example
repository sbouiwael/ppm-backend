# ==============================================================
# PPM BIAT — Variables d'environnement (exemple)
# Copier ce fichier en .env et adapter les valeurs.
# NE PAS committer .env en git (deja dans .gitignore).
# ==============================================================

# === Serveur ===
SERVER_PORT=8082

# === Base de donnees MySQL ===
DB_HOST=localhost
DB_PORT=3306
DB_NAME=PPM
DB_USER=root
DB_PASSWORD=your_strong_mysql_password_here

# === JPA (update en dev, validate en prod avec Flyway) ===
DDL_AUTO=update

# === JWT (OBLIGATOIRE — generer une cle aleatoire longue) ===
# Generer: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_USE_A_VERY_LONG_RANDOM_SECRET_KEY_AT_LEAST_64_HEX_CHARS
JWT_EXPIRATION_MS=86400000

# === CORS ===
# URL(s) du frontend autorisees — separer par des virgules
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80

# === Stockage fichiers ===
FILE_UPLOAD_DIR=./projects

# === Frontend Nginx (docker-compose uniquement) ===
# Pointe vers le service backend dans le reseau Docker
BACKEND_URL=http://backend:8082